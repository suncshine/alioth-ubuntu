+/**
+ * drm_bridge_chain_first_frame_done - notify bridges of the first frame
+ * @encoder: encoder whose bridge chain transmitted the frame
+ *
+ * Calls &drm_bridge_funcs.first_frame_done for all the bridges in the
+ * encoder chain, starting from the first bridge to the last. Display drivers
+ * shall call this after the first frame following a display enable has been
+ * transmitted to the panel.
+ */
+void drm_bridge_chain_first_frame_done(struct drm_encoder *encoder)
+{
+	if (!encoder)
+		return;
 
+	drm_for_each_bridge_in_chain_scoped(encoder, bridge)
+		if (bridge->funcs->first_frame_done)
+			bridge->funcs->first_frame_done(bridge);
+}
+EXPORT_SYMBOL(drm_bridge_chain_first_frame_done);
