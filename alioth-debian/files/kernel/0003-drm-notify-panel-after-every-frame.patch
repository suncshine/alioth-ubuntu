+/**
+ * drm_bridge_chain_frame_done - notify bridges that a frame was transmitted
+ * @encoder: encoder whose bridge chain transmitted the frame
+ *
+ * Calls &drm_bridge_funcs.frame_done for all the bridges in the encoder
+ * chain, starting from the first bridge to the last. Display drivers shall
+ * call this after each frame has been transmitted to the panel.
+ */
+void drm_bridge_chain_frame_done(struct drm_encoder *encoder)
+{
+	if (!encoder)
+		return;
+
+	drm_for_each_bridge_in_chain_scoped(encoder, bridge)
+		if (bridge->funcs->frame_done)
+			bridge->funcs->frame_done(bridge);
+}
+EXPORT_SYMBOL(drm_bridge_chain_frame_done);
