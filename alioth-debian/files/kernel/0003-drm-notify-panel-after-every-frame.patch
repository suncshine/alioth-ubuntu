+/**
+ * drm_panel_frame_done - notify the panel that a frame was transmitted
+ * @panel: DRM panel
+ *
+ * Called by the display driver after a frame has been transmitted to the
+ * panel. For command-mode panels this can be used to flush deferred command
+ * updates, such as DCS brightness changes, when the DSI link is idle.
+ */
+void drm_panel_frame_done(struct drm_panel *panel)
+{
+	if (!panel)
+		return;
+
+	if (panel->frame_done)
+		panel->frame_done(panel);
+}
+EXPORT_SYMBOL(drm_panel_frame_done);
 
