+static void ams667xx01_bl_flush(struct ams667xx01 *ctx)
+{
+	u16 brightness;
+	bool pending;
+
+	mutex_lock(&ctx->bl_lock);
+	pending = ctx->bl_pending;
+	brightness = ctx->bl_pending_value;
+	ctx->bl_pending = false;
+	mutex_unlock(&ctx->bl_lock);
+
+	if (pending)
+		ams667xx01_bl_apply(ctx, brightness);
+}
+
+static void ams667xx01_bl_work(struct work_struct *work)
+{
+	struct ams667xx01 *ctx = container_of(work, struct ams667xx01,
+					      bl_work.work);
+	unsigned long last_frame = READ_ONCE(ctx->bl_last_frame);
+
+	if (!ctx->panel.enabled)
+		return;
+
+	/*
+	 * Frames are still being transmitted: let the frame-done path flush
+	 * the update instead. Sending a DCS command while an MDP frame is in
+	 * flight makes the DSI HS FIFOs underflow and corrupts the frame.
+	 */
+	if (time_before(jiffies, last_frame + msecs_to_jiffies(40))) {
+		schedule_delayed_work(&ctx->bl_work, msecs_to_jiffies(20));
+		return;
+	}
+
+	ams667xx01_bl_flush(ctx);
+}
+
+static void ams667xx01_frame_done(struct drm_panel *panel)
+{
+	struct ams667xx01 *ctx = to_ams667xx01(panel);
+
+	if (!panel->enabled)
+		return;
+
+	WRITE_ONCE(ctx->bl_last_frame, jiffies);
+
+	/*
+	 * A frame has just been transmitted: the DSI link is idle now, so a
+	 * DCS brightness update cannot race with an MDP frame transfer.
+	 */
+	cancel_delayed_work(&ctx->bl_work);
+	ams667xx01_bl_flush(ctx);
+}
+
+static int ams667xx01_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct ams667xx01 *ctx = mipi_dsi_get_drvdata(dsi);
+	u16 brightness = backlight_get_brightness(bl);
+
+	mutex_lock(&ctx->bl_lock);
+	ctx->bl_pending_value = brightness;
+	ctx->bl_pending = true;
+	mutex_unlock(&ctx->bl_lock);
+
+	/* fallback for a static screen where no frame done arrives */
+	schedule_delayed_work(&ctx->bl_work, msecs_to_jiffies(30));
+
 	return 0;
 }
 
